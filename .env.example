# 이 파일을 .env로 복사해 키를 넣는다. .env는 커밋되지 않는다.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 응답 대기 한도(초)와 재시도 횟수. 오래 멈춰 있으면 줄인다
GEMINI_TIMEOUT=90
GEMINI_RETRIES=2

# 영구 저장(선택): 승인 퀘스트·기획 지침을 GitHub 저장소의 quest-data 브랜치에도 저장
# Fine-grained token, 이 저장소만, Contents: Read and write
GITHUB_TOKEN=
# QUEST_GITHUB_REPO=thegamerham-ship-it/quest-workshop
# QUEST_GITHUB_BRANCH=quest-data
